@page "/"
@model BoreholeHub.Web.Pages.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = null;
}

<div class="container">
    <section class="hero">
        <div>
            <p class="eyebrow">@L["Bohrdaten · Karte · Prüfung"]</p>
            <h1>BoreholeHub</h1>
            <p class="lead">@L["Aufschlüsse erfassen, auf der Karte sehen, Schichten und Laborwerte prüfen."]</p>
            <div class="hero-actions">
                <form method="post" action="/Demo" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">@L["Demo-Projekt laden"]</button>
                </form>
                <a class="btn btn-secondary" href="/Projekte">@L["Projekte ansehen"]</a>
            </div>
            <p class="hero-stats">
                @Model.ProjektAnzahl @(Model.ProjektAnzahl == 1 ? L["Projekt"] : L["Projekte"]) · @Model.AufschlussAnzahl @(Model.AufschlussAnzahl == 1 ? L["Aufschluss"] : L["Aufschlüsse"]) @L["in der Datenbank"]
            </p>
        </div>

        <figure class="profile-figure">
            <svg viewBox="0 0 440 340" role="img" aria-label="@L["Schematisches Schichtenprofil mit Grundwasserstand"]">
                <rect class="pf-bg" x="0" y="0" width="440" height="340" />
                <!-- ground line -->
                <text class="pf-muted" x="24" y="34" font-size="12" font-family="Inter, system-ui, sans-serif">0,0 m</text>
                <!-- column -->
                <rect x="80" y="44" width="96" height="30" fill="#6f6a5e" />
                <rect x="80" y="74" width="96" height="96" fill="#c9a26b" />
                <rect x="80" y="170" width="96" height="104" fill="#8a5a3b" />
                <rect x="80" y="274" width="96" height="30" fill="#b85a2e" />
                <rect class="pf-frame" x="80" y="44" width="96" height="260" />
                <!-- ground water -->
                <line class="pf-gw" x1="60" y1="214" x2="196" y2="214" />
                <path class="pf-water" d="M44 208 l8 12 h-16 z" transform="translate(0 -4)" />
                <!-- labels: soil layer names stay German (layer descriptions, see FLAGS) -->
                <g class="pf-ink" font-family="Inter, system-ui, sans-serif" font-size="13">
                    <text x="212" y="63">Oberboden</text>
                    <text x="212" y="127">Auenlehm</text>
                    <text x="212" y="250">Flusskies</text>
                    <text x="212" y="293">Verwitterungszone</text>
                </g>
                <g class="pf-lead-lines">
                    <line class="pf-lead" x1="176" y1="59" x2="204" y2="59" />
                    <line class="pf-lead" x1="176" y1="122" x2="204" y2="122" />
                    <line class="pf-lead" x1="176" y1="246" x2="204" y2="246" />
                    <line class="pf-lead" x1="176" y1="289" x2="204" y2="289" />
                </g>
                <text class="pf-water" x="212" y="208" font-family="Inter, system-ui, sans-serif" font-size="12">@L["Grundwasser"]</text>
                <!-- depth scale -->
                <g class="pf-muted" font-family="Inter, system-ui, sans-serif" font-size="12">
                    <text x="24" y="135">1</text>
                    <text x="24" y="222">2</text>
                    <text x="24" y="308">3 m</text>
                </g>
            </svg>
            <figcaption>@L["Schematische Darstellung, keine Messdaten."]</figcaption>
        </figure>
    </section>

    <section class="steps" aria-label="@L["Ablauf"]">
        <div class="card-grid cols-3">
            <div class="card">
                <p class="step-no">01</p>
                <h2>@L["Erfassen"]</h2>
                <p>@L["Kleinrammbohrungen und Rammsondierungen mit Koordinaten, Endteufe und Grundwasser."]</p>
            </div>
            <div class="card">
                <p class="step-no">02</p>
                <h2>@L["Sehen"]</h2>
                <p>@L["Alle Aufschlüsse auf der Karte, optional mit Geologie und Boden als Überlagerung."]</p>
            </div>
            <div class="card">
                <p class="step-no">03</p>
                <h2>@L["Prüfen"]</h2>
                <p>@L["Schichten, Rammsondierung und Laborwerte im Überblick, mit Beispielgrenzwerten."]</p>
            </div>
        </div>
    </section>
</div>
