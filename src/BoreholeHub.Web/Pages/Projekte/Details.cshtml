@page "/Projekte/{id:int}"
@model BoreholeHub.Web.Pages.Projekte.DetailsModel
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = Model.Projekt.Name;
    var de = CultureInfo.GetCultureInfo("de-DE");
}

<div class="container">
    <nav class="breadcrumb" aria-label="@L["Brotkrumen"]">
        <ol>
            <li><a href="/Projekte">@L["Projekte"]</a></li>
            <li aria-current="page">@Model.Projekt.Name</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>@Model.Projekt.Name</h1>
        <p class="muted">@Model.Projekt.Ort · @Model.Projekt.Auftraggeber</p>
        <div class="page-actions">
            <a class="btn btn-primary" href="/Projekte/@Model.Projekt.Id/Karte">@L["Karte öffnen"]</a>
            <a class="btn btn-secondary" href="/Projekte/@Model.Projekt.Id?handler=Pdf">@L["PDF-Bericht"]</a>
        </div>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "uebersicht"))

    @if (!string.IsNullOrWhiteSpace(Model.Projekt.Beschreibung))
    {
        <p class="lead-text">@Model.Projekt.Beschreibung</p>
    }

    <section class="kpi-row" aria-label="@L["Kennzahlen"]">
        <div class="kpi">
            <div class="kpi-value">@Model.Gesamt.ToString(de)</div>
            <div class="kpi-label">@L["Aufschlüsse"]</div>
        </div>
        <div class="kpi kpi-rust">
            <div class="kpi-value">@Model.Kleinrammbohrungen.ToString(de)</div>
            <div class="kpi-label">@L["Kleinrammbohrungen"]</div>
        </div>
        <div class="kpi kpi-water">
            <div class="kpi-value">@Model.Rammsondierungen.ToString(de)</div>
            <div class="kpi-label">@L["Rammsondierungen"]</div>
        </div>
        <div class="kpi">
            <div class="kpi-value">@(Model.MaxEndteufeM is double max ? DetailsModel.Meter(max) : "–")</div>
            <div class="kpi-label">@L["Max. Endteufe"]</div>
        </div>
        <div class="kpi kpi-water">
            <div class="kpi-value">@Model.MitGrundwasser.ToString(de)</div>
            <div class="kpi-label">@L["Grundwasser angetroffen"]</div>
        </div>
    </section>

    @if (Model.Aufschluesse.Count == 0)
    {
        <div class="empty-state">
            <p>@L["Für dieses Projekt sind noch keine Aufschlüsse erfasst."]</p>
        </div>
    }
    else
    {
        <h2 class="section-title">@L["Aufschlüsse"]</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Bezeichnung"]</th>
                        <th scope="col">@L["Art"]</th>
                        <th scope="col">@L["Datum"]</th>
                        <th scope="col" class="num">@L["Ansatzhöhe [m NHN]"]</th>
                        <th scope="col" class="num">@L["Endteufe [m]"]</th>
                        <th scope="col" class="num">@L["Grundwasser [m u. GOK]"]</th>
                        <th scope="col" class="num">@L["Rechtswert"]</th>
                        <th scope="col" class="num">@L["Hochwert"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Aufschluesse)
                    {
                        <tr>
                            <th scope="row"><a href="/Aufschluesse/@a.Id">@a.Bezeichnung</a></th>
                            <td>
                                @if (a.Art == AufschlussArt.Kleinrammbohrung)
                                {
                                    <span class="badge badge-krb">@L["Kleinrammbohrung"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-dph">@L["Rammsondierung"]</span>
                                }
                            </td>
                            <td>@a.Datum.ToString("dd.MM.yyyy", de)</td>
                            <td class="num">@a.AnsatzhoeheMNhn.ToString("0.0", de)</td>
                            <td class="num">@a.EndteufeM.ToString("0.0", de)</td>
                            <td class="num">@(a.GrundwasserM is double gw ? gw.ToString("0.0", de) : "–")</td>
                            <td class="num">@DetailsModel.Koordinate(a.Rechtswert)</td>
                            <td class="num">@DetailsModel.Koordinate(a.Hochwert)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="margin-top: var(--s3); font-size: var(--fs-1);">@L["Koordinaten: ETRS89 / UTM 32N (EPSG:25832)"]</p>
    }
</div>
