@page "/Projekte/{id:int}/Daten"
@model BoreholeHub.Web.Pages.Projekte.DatenModel
@{
    ViewData["Title"] = Model.Projekt.Name + " · Daten";
}

@section Head {
    <link rel="stylesheet" href="~/css/daten.css" asp-append-version="true" />
}

<div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
        <ol>
            <li><a href="/Projekte">Projekte</a></li>
            <li><a href="/Projekte/@Model.Projekt.Id">@Model.Projekt.Name</a></li>
            <li aria-current="page">Daten</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>Daten</h1>
        <p class="muted">@Model.Projekt.Name</p>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "daten"))

    @if (Model.ImportVersucht)
    {
        if (Model.Erfolg)
        {
            <section class="result result-ok" role="status" aria-labelledby="ergebnis-titel">
                <h2 id="ergebnis-titel">Import abgeschlossen</h2>
                <p>@DatenModel.Plural(Model.ImportierteAufschluesse, "Aufschluss", "Aufschlüsse") und @DatenModel.Plural(Model.ImportierteSchichten, "Schicht", "Schichten") importiert.</p>
                <p>Prüfung: @Model.PruefungFehler Fehler, @Model.PruefungHinweise Hinweise. <a href="/Projekte/@Model.Projekt.Id/Pruefung">Zur Prüfung</a></p>
                <p><a class="btn btn-primary" href="/Projekte/@Model.Projekt.Id/Karte">Auf der Karte ansehen</a></p>
            </section>
        }
        else
        {
            <section class="result result-bad" role="alert" aria-labelledby="ergebnis-titel">
                <h2 id="ergebnis-titel">Import nicht möglich (@Model.Fehler.Count @(Model.Fehler.Count == 1 ? "Fehler" : "Fehler"))</h2>
                <p>Es wurde nichts gespeichert. Bitte die Dateien korrigieren und erneut hochladen.</p>
                <ol class="error-list">
                    @foreach (var f in Model.Fehler)
                    {
                        <li>@f</li>
                    }
                </ol>
            </section>
        }
    }

    <div class="daten-grid">
        <section class="card" aria-labelledby="export-titel">
            <h2 id="export-titel">Export</h2>
            <p class="muted">GeoJSON mit allen Aufschlüssen dieses Projekts (WGS84).</p>
            <p class="card-action"><a class="btn btn-primary" href="/Projekte/@Model.Projekt.Id/Daten?handler=GeoJson">GeoJSON herunterladen</a></p>
            <p class="hint">Öffnet direkt in QGIS (Ebene hinzufügen › Vektor)</p>
        </section>

        <section class="card card-import" aria-labelledby="import-titel">
            <h2 id="import-titel">Import</h2>
            <p class="muted">Aufschlüsse und Schichten aus CSV-Dateien zum Projekt hinzufügen. Es wird entweder alles oder nichts importiert.</p>

            <form method="post" action="/Projekte/@Model.Projekt.Id/Daten?handler=Import" enctype="multipart/form-data" class="import-form">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="aufschluesseCsv">Aufschlüsse (CSV)</label>
                    <input type="file" id="aufschluesseCsv" name="aufschluesseCsv" accept=".csv,text/csv" />
                </div>
                <div class="field">
                    <label for="schichtenCsv">Schichten (CSV)</label>
                    <input type="file" id="schichtenCsv" name="schichtenCsv" accept=".csv,text/csv" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Importieren</button>
                    <span class="hint">Vorlagen:
                        <a href="/Projekte/@Model.Projekt.Id/Daten?handler=VorlageAufschluesse">vorlage-aufschluesse.csv</a>,
                        <a href="/Projekte/@Model.Projekt.Id/Daten?handler=VorlageSchichten">vorlage-schichten.csv</a></span>
                </div>
            </form>

            <h3>Regeln</h3>
            <ul class="rules">
                <li>Semikolon als Trennzeichen, Dezimalkomma, UTF-8 (mit oder ohne BOM), höchstens 1 MB je Datei.</li>
                <li>Koordinaten in ETRS89 / UTM 32N (EPSG:25832); Datum als TT.MM.JJJJ; Art ist KRB oder DPH.</li>
                <li>Eine Bezeichnung, die im Projekt schon vorhanden ist, wird nicht importiert (Fehler).</li>
                <li>Schichten einer Kleinrammbohrung müssen lückenlos von 0 bis zur Endteufe reichen.</li>
                <li>Frostklasse leer oder F1, F2, F3; kf z. B. 5E-08, 5,0E-08 oder 0,00000005.</li>
                <li>Beide Dateien sind optional; Schichten können sich auf Aufschlüsse derselben Sitzung oder des Projekts beziehen.</li>
            </ul>
        </section>
    </div>
</div>
