@page "/NotFound"
@model BoreholeHub.Web.Pages.NotFoundModel
@{
    ViewData["Title"] = "Seite nicht gefunden";
}

<div class="container">
    <div class="message-page">
        <p class="eyebrow">Fehler 404</p>
        <h1>Seite nicht gefunden</h1>
        <p>Diese Adresse gibt es nicht, oder das Projekt wurde entfernt.</p>
        <a class="btn btn-primary" href="/Projekte">Zu den Projekten</a>
    </div>
</div>
