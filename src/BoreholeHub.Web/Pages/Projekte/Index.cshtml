@page "/Projekte"
@model BoreholeHub.Web.Pages.Projekte.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@inject Microsoft.Extensions.Localization.IStringLocalizer<BoreholeHub.Web.SharedResource> T
@{
    ViewData["Title"] = T["Projekte"].Value;
}

<div class="container">
    <nav class="breadcrumb" aria-label="@T["Brotkrumen"]">
        <ol>
            <li><a href="/">@L["Start"]</a></li>
            <li aria-current="page">@T["Projekte"]</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>@T["Projekte"]</h1>
    </header>

    @if (Model.Projekte.Count == 0)
    {
        <div class="empty-state">
            <p>@L["Noch keine Projekte vorhanden."]</p>
            <form method="post" action="/Demo" class="inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">@T["Demo-Projekt laden"]</button>
            </form>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var p in Model.Projekte)
            {
                <a class="card" href="/Projekte/@p.Id">
                    <h2>@p.Name</h2>
                    <p class="muted">@p.Ort · @p.Auftraggeber</p>
                    <div class="card-meta">
                        <span class="badge badge-krb">@p.Kleinrammbohrungen @(p.Kleinrammbohrungen == 1 ? L["Kleinrammbohrung"] : L["Kleinrammbohrungen"])</span>
                        <span class="badge badge-dph">@p.Rammsondierungen @(p.Rammsondierungen == 1 ? L["Rammsondierung"] : L["Rammsondierungen"])</span>
                    </div>
                    <p class="card-foot">@L["Erstellt am {0}", p.ErstelltAm.ToString("dd.MM.yyyy")]</p>
                </a>
            }
        </div>
    }
</div>
