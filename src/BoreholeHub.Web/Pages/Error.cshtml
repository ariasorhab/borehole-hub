@page "/Error"
@model BoreholeHub.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Fehler";
}

<div class="container">
    <div class="message-page">
        <p class="eyebrow">Fehler</p>
        <h1>Das hat nicht geklappt</h1>
        <p>Beim Verarbeiten der Anfrage ist ein unerwarteter Fehler aufgetreten. Bitte versuchen Sie es noch einmal.</p>
        <a class="btn btn-primary" href="/">Zur Startseite</a>
    </div>
</div>
