@page "/Projekte/{id:int}/Karte"
@model BoreholeHub.Web.Pages.Projekte.KarteModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@inject Microsoft.Extensions.Localization.IStringLocalizer<BoreholeHub.Web.SharedResource> T
@{
    ViewData["Title"] = Model.Projekt.Name + " · " + T["Karte"].Value;
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

<div class="container">
    <nav class="breadcrumb" aria-label="@T["Brotkrumen"]">
        <ol>
            <li><a href="/Projekte">@T["Projekte"]</a></li>
            <li><a href="/Projekte/@Model.Projekt.Id">@Model.Projekt.Name</a></li>
            <li aria-current="page">@T["Karte"]</li>
        </ol>
    </nav>

    <header class="page-header karte-head">
        <h1>@Model.Projekt.Name</h1>
        <p class="muted">@L["Koordinaten: ETRS89 / UTM 32N (EPSG:25832)"]</p>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "karte"))

    <div class="karte-layout" id="karte" data-punkte-url="/Projekte/@Model.Projekt.Id/Karte?handler=Punkte"
         data-t-gk25="@L["Geologie (GK 25)"]"
         data-t-no-unit="@L["Hier ist keine Kartiereinheit verzeichnet."]"
         data-t-unit="@L["Kartiereinheit"]"
         data-t-code="@L["Kürzel"]"
         data-t-krb="@L["Kleinrammbohrung"]"
         data-t-dph="@L["Rammsondierung"]"
         data-t-type="@T["Art"]"
         data-t-depth="@T["Endteufe"]"
         data-t-start="@T["Ansatzhöhe"]"
         data-t-groundwater="@L["Grundwasser"]"
         data-t-none="@L["nicht angetroffen"]"
         data-t-below="@L["m u. GOK"]"
         data-t-easting="@T["Rechtswert"]"
         data-t-northing="@T["Hochwert"]"
         data-t-profile="@L["Profil öffnen"]"
         data-t-load-error="@L["Die Punkte konnten nicht geladen werden."]"
         data-t-osm="@L["© OpenStreetMap-Mitwirkende"]">
        <aside class="karte-panel" aria-label="@L["Kartenleiste"]">
            <section class="karte-section">
                <h2 class="karte-title">@L["Ebenen"]</h2>
                <label class="karte-check">
                    <input type="checkbox" id="layer-gk25" />
                    <span>@L["Geologie (GK 25, HLNUG)"]</span>
                </label>
                <div class="karte-opacity" hidden>
                    <input type="range" min="0" max="100" step="5" value="60" id="opacity-layer-gk25" aria-label="@L["Deckkraft Geologie (GK 25)"]" />
                    <output for="opacity-layer-gk25">60 %</output>
                </div>
                <label class="karte-check">
                    <input type="checkbox" id="layer-geologie" />
                    <span>@L["Geologie (GÜK 300, HLNUG)"]</span>
                </label>
                <div class="karte-opacity" hidden>
                    <input type="range" min="0" max="100" step="5" value="60" id="opacity-layer-geologie" aria-label="@L["Deckkraft Geologie (GÜK 300)"]" />
                    <output for="opacity-layer-geologie">60 %</output>
                </div>
                <label class="karte-check">
                    <input type="checkbox" id="layer-boden" />
                    <span>@L["Boden (BFD 50, HLNUG)"]</span>
                </label>
                <div class="karte-opacity" hidden>
                    <input type="range" min="0" max="100" step="5" value="60" id="opacity-layer-boden" aria-label="@L["Deckkraft Boden (BFD 50)"]" />
                    <output for="opacity-layer-boden">60 %</output>
                </div>
                <p class="karte-hint">@L["GK 25: Klick in die Karte zeigt die Kartiereinheit. GÜK 300 ist nur bei Maßstäben kleiner als etwa 1:22.000 sichtbar. Bodenkarte: nur private Nutzung erlaubt. Quelle: © HLNUG."]</p>
            </section>

            <section class="karte-section">
                <a class="btn btn-secondary btn-sm" href="/Projekte/@Model.Projekt.Id/Profilschnitt">@T["Profilschnitt"]</a>
            </section>

            <section class="karte-section">
                <h2 class="karte-title">@L["Kleinrammbohrungen"] <span class="muted">(@Model.Kleinrammbohrungen.Count)</span></h2>
                <ul class="karte-list">
                    @foreach (var z in Model.Kleinrammbohrungen)
                    {
                        <li>
                            <button type="button" class="karte-item" data-id="@z.Id">
                                <span class="mk mk-krb @(z.GrundwasserM is not null ? "has-gw" : "")" aria-hidden="true"></span>
                                <span class="karte-item-text">
                                    <strong>@z.Bezeichnung</strong>
                                    <span class="muted">@Model.Kurzinfo(z)</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            </section>

            <section class="karte-section">
                <h2 class="karte-title">@L["Rammsondierungen"] <span class="muted">(@Model.Rammsondierungen.Count)</span></h2>
                <ul class="karte-list">
                    @foreach (var z in Model.Rammsondierungen)
                    {
                        <li>
                            <button type="button" class="karte-item" data-id="@z.Id">
                                <span class="mk mk-dph" aria-hidden="true"></span>
                                <span class="karte-item-text">
                                    <strong>@z.Bezeichnung</strong>
                                    <span class="muted">@Model.Kurzinfo(z)</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        </aside>

        <div class="karte-map-wrap">
            <div class="karte-map" id="karte-map" role="application" aria-label="@L["Karte der Aufschlüsse"]"></div>
            <ul class="karte-legend" aria-label="@L["Legende"]">
                <li><span class="mk mk-krb" aria-hidden="true"></span> @L["Kleinrammbohrung (KRB)"]</li>
                <li><span class="mk mk-dph" aria-hidden="true"></span> @L["Rammsondierung (DPH)"]</li>
                <li><span class="mk mk-krb has-gw" aria-hidden="true"></span> @L["Grundwasser angetroffen"]</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/karte.js" asp-append-version="true"></script>
}
