@page "/Projekte/{id:int}/Pruefung"
@model BoreholeHub.Web.Pages.Projekte.PruefungModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = Model.Projekt.Name + " · " + L["Prüfung"].Value;
}

@section Head {
    <link rel="stylesheet" href="~/css/pruefung.css" asp-append-version="true" />
}

<div class="container">
    <nav class="breadcrumb" aria-label="@L["Brotkrumen"]">
        <ol>
            <li><a href="/Projekte">@L["Projekte"]</a></li>
            <li><a href="/Projekte/@Model.Projekt.Id">@Model.Projekt.Name</a></li>
            <li aria-current="page">@L["Prüfung"]</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>@L["Prüfung"]</h1>
        <p class="muted">@Model.Projekt.Name</p>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "pruefung"))

    @if (Model.AnzahlAufschluesse == 0)
    {
        <div class="empty-state"><p>@L["Noch keine Aufschlüsse erfasst."]</p></div>
    }
    else
    {
        <section class="kpi-row pruefung-kpis" aria-label="@L["Kennzahlen Prüfung"]">
            <div class="kpi kpi-bad">
                <div class="kpi-value">@Model.AnzahlFehler</div>
                <div class="kpi-label">@L["Fehler"]</div>
            </div>
            <div class="kpi kpi-warn">
                <div class="kpi-value">@Model.AnzahlHinweise</div>
                <div class="kpi-label">@L["Hinweise"]</div>
            </div>
            <div class="kpi kpi-ok">
                <div class="kpi-value">@Model.OhneBefund / @Model.AnzahlAufschluesse</div>
                <div class="kpi-label">@L["Ohne Befund"]</div>
            </div>
        </section>

        <section aria-labelledby="pruefung-titel">
            <h2 class="section-title" id="pruefung-titel">@L["Befunde"]</h2>
            <div class="table-wrap">
                <table class="data-table pruefung-table">
                    <caption class="sr-only">@L["Befunde der Datenprüfung je Aufschluss"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["Stufe"]</th>
                            <th scope="col">@L["Aufschluss"]</th>
                            <th scope="col">@L["Regel"]</th>
                            <th scope="col">@L["Meldung"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var z in Model.Zeilen)
                        {
                            <tr class="@z.RowCss">
                                <td><span class="badge @z.StufeCss">@z.Stufe</span></td>
                                <td><a href="/Aufschluesse/@z.AufschlussId">@z.Aufschluss</a></td>
                                <td>@z.Regel</td>
                                <td class="meldung">@z.Meldung</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <p class="note">@L["Automatische Plausibilitätsprüfung der erfassten Daten. Sie ersetzt keine fachliche Prüfung."]</p>
</div>
