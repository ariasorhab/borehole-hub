<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script>
        /* Set the theme before first paint (no flash): saved choice, else the OS setting. */
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("bh-theme"); } catch (e) { theme = null; }
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-theme", theme);
        }());
    </script>
    <title>@(string.IsNullOrEmpty(ViewData["Title"] as string) ? "BoreholeHub" : ViewData["Title"] + " · BoreholeHub")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
        <div class="strata" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="container site-header-inner">
            <a class="wordmark" href="/">BoreholeHub</a>
            <nav class="site-nav" aria-label="Hauptnavigation">
                <a href="/Projekte">Projekte</a>
                <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Dunkelmodus ein" title="Dunkelmodus ein">
                    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>Demo mit synthetischen Daten · Mit KI-Unterstützung erstellt, entworfen und geprüft von Sohrab Talebian Far · Version 1.0.0</p>
        </div>
    </footer>

    <script>
        (function () {
            var button = document.getElementById("theme-toggle");
            if (!button) { return; }
            function current() { return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light"; }
            function label() {
                var text = current() === "dark" ? "Dunkelmodus aus" : "Dunkelmodus ein";
                button.setAttribute("aria-label", text);
                button.setAttribute("title", text);
            }
            label();
            button.addEventListener("click", function () {
                var next = current() === "dark" ? "light" : "dark";
                document.documentElement.setAttribute("data-theme", next);
                try { localStorage.setItem("bh-theme", next); } catch (e) { /* storage blocked: the choice only lasts for this page */ }
                label();
            });
        }());
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
