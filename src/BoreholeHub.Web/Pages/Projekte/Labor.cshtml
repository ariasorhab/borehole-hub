@page "/Projekte/{id:int}/Labor"
@model BoreholeHub.Web.Pages.Projekte.LaborModel
@{
    ViewData["Title"] = Model.Projekt.Name + " · Labor";
}

@section Head {
    <link rel="stylesheet" href="~/css/labor.css" asp-append-version="true" />
}

<div class="container">
    <nav class="breadcrumb" aria-label="Brotkrumen">
        <ol>
            <li><a href="/Projekte">Projekte</a></li>
            <li><a href="/Projekte/@Model.Projekt.Id">@Model.Projekt.Name</a></li>
            <li aria-current="page">Labor &amp; Versickerung</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>Labor &amp; Versickerung</h1>
        <p class="muted">@Model.Projekt.Name</p>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "labor"))

    <p class="notice">Beispielwerte zur Demonstration – keine amtlichen Werte der Ersatzbaustoffverordnung (EBV).</p>

    <section class="kpi-row labor-kpis" aria-label="Kennzahlen Laborproben">
        <div class="kpi">
            <div class="kpi-value">@Model.AnzahlProben</div>
            <div class="kpi-label">Proben</div>
        </div>
        <div class="kpi kpi-ok">
            <div class="kpi-value">@Model.AnzahlBm0</div>
            <div class="kpi-label">Einstufung BM-0</div>
        </div>
        <div class="kpi kpi-warn">
            <div class="kpi-value">@Model.AnzahlHoehere</div>
            <div class="kpi-label">Höhere Klasse</div>
        </div>
        <div class="kpi kpi-bad">
            <div class="kpi-value">@Model.AnzahlUeberschreitung</div>
            <div class="kpi-label">Überschreitung</div>
        </div>
    </section>

    <section aria-labelledby="labor-titel">
        <h2 class="section-title" id="labor-titel">Laborwerte</h2>

        <div class="legend" aria-label="Legende der Beispielklassen">
            <span class="legend-title">Beispielklassen (streng bis weniger streng):</span>
            @foreach (var k in Model.Klassen)
            {
                <span class="badge @(k == Model.Klassen[0] ? "badge-ok" : "badge-warn")">@k</span>
            }
            <span class="badge badge-bad">&gt; @Model.Klassen[^1]</span>
            <span class="legend-note">= Überschreitung aller Klassen</span>
        </div>

        <input type="checkbox" id="nur-auffaellig" class="filter-box" />
        <label for="nur-auffaellig" class="filter-label">Nur auffällige Proben</label>

        <div class="sample-list">
            @foreach (var p in Model.Proben)
            {
                <article class="card sample-card" id="probe-@p.ProbeId" data-auffaellig="@(p.Auffaellig ? "true" : "false")">
                    <header class="sample-head">
                        <h3>@p.Bezeichnung · @p.Tiefe · @p.Schicht</h3>
                        <span class="badge @p.GesamtCss">@p.Gesamt</span>
                    </header>
                    <div class="table-wrap table-flat">
                        <table class="data-table">
                            <caption class="sr-only">Laborwerte der Probe @p.Bezeichnung</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Parameter</th>
                                    <th scope="col" class="num">Wert</th>
                                    <th scope="col">Einheit</th>
                                    <th scope="col">Einstufung</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var z in p.Zeilen)
                                {
                                    <tr class="@(z.Rang == int.MaxValue ? "row-bad" : z.Rang > 1 ? "row-warn" : "")">
                                        <th scope="row">@z.Parameter</th>
                                        <td class="num">@z.Wert</td>
                                        <td>@z.Einheit</td>
                                        <td><span class="badge @z.BadgeCss">@z.Einstufung</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
            @if (Model.Proben.Count == 0)
            {
                <div class="empty-state"><p>Für dieses Projekt sind noch keine Proben erfasst.</p></div>
            }
        </div>

        <details class="limits">
            <summary>Beispielgrenzwerte anzeigen</summary>
            <p class="muted">Beispielwerte zur Demonstration – keine amtlichen Werte der Ersatzbaustoffverordnung (EBV). Einheit: mg/kg.</p>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Parameter</th>
                            @foreach (var k in Model.Klassen)
                            {
                                <th scope="col" class="num">@k</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model.Grenzen)
                        {
                            <tr>
                                <th scope="row">@g.Parameter</th>
                                @foreach (var w in g.Werte)
                                {
                                    <td class="num">@w</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>

    <section class="versickerung" aria-labelledby="versickerung-titel">
        <h2 class="section-title" id="versickerung-titel">Versickerung (Vorprüfung)</h2>
        @if (Model.Versickerung.Count == 0)
        {
            <p class="muted">Keine Schicht mit kf-Wert vorhanden.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="sr-only">Vorprüfung der Versickerung je Schicht</caption>
                    <thead>
                        <tr>
                            <th scope="col">Aufschluss</th>
                            <th scope="col">Schicht</th>
                            <th scope="col" class="num">kf [m/s]</th>
                            <th scope="col">Ergebnis</th>
                            <th scope="col">Begründung</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Versickerung)
                        {
                            <tr>
                                <th scope="row">@v.Aufschluss</th>
                                <td>@v.Schicht</td>
                                <td class="num">@v.Kf</td>
                                <td><span class="badge @v.Css">@v.Ergebnis</span></td>
                                <td>@v.Grund</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="note">Vereinfachte Vorprüfung: Der kf-Wert ersetzt keine Bemessung nach DWA-A 138-1.</p>
        }
    </section>
</div>
