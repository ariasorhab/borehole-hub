@page "/Aufschluesse/{id:int}"
@model BoreholeHub.Web.Pages.Aufschluesse.DetailsModel
@using System.Globalization
@using BoreholeHub.Web.Pages.Aufschluesse
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    var a = Model.Aufschluss;
    ViewData["Title"] = a.Bezeichnung + " · " + Model.Projekt.Name;
    var de = CultureInfo.GetCultureInfo("de-DE");
}

@section Head {
    <link rel="stylesheet" href="~/css/aufschluss.css" asp-append-version="true" />
}

<div class="container">
    <nav class="breadcrumb" aria-label="@L["Brotkrumen"]">
        <ol>
            <li><a href="/Projekte">@L["Projekte"]</a></li>
            <li><a href="/Projekte/@Model.Projekt.Id">@Model.Projekt.Name</a></li>
            <li aria-current="page">@a.Bezeichnung</li>
        </ol>
    </nav>

    <header class="page-header">
        <h1>@a.Bezeichnung</h1>
        <p class="muted">
            @(Model.IstKleinrammbohrung ? L["Kleinrammbohrung"] : L["Rammsondierung"]) · @L["Endteufe"] @DetailsModel.Meter(a.EndteufeM) m ·
            @L["Ansatzhöhe"] @DetailsModel.Meter(a.AnsatzhoeheMNhn) m NHN ·
            @(a.GrundwasserM is double gw ? L["Grundwasser"].Value + " " + DetailsModel.Meter(gw) + " " + L["m u. GOK"].Value : L["Grundwasser nicht angetroffen"].Value)
        </p>
        <div class="page-actions">
            <a class="btn btn-secondary" href="/Projekte/@Model.Projekt.Id/Karte">@L["Zurück zur Karte"]</a>
        </div>
    </header>

    @await Html.PartialAsync("_ProjektTabs", new BoreholeHub.Web.Pages.Shared.ProjektTabsModel(Model.Projekt.Id, "uebersicht"))

    <section class="profil-grid" aria-label="@L["Bohrprofil und Rammdiagramm"]">
        <figure class="drawing drawing-log">
            @if (Model.BohrprofilSvgHtml is not null)
            {
                <div class="drawing-scroll">@Html.Raw(Model.BohrprofilSvgHtml)</div>
                <figcaption>
                    @if (!Model.IstKleinrammbohrung && Model.Bohrung is not null && Model.AbstandM is double d1)
                    {
                        <strong>@Model.Bohrung.Bezeichnung · @DetailsModel.AbstandText(d1, Model.Loc)</strong> <span>@L["(nächstgelegene Kleinrammbohrung)"]</span><br />
                    }
                    @L["Darstellung in Anlehnung an DIN 4023 (vereinfacht) · Bezug: DIN 4023:2023-02"]
                </figcaption>
            }
            else
            {
                <div class="empty-state"><p>@L["In diesem Projekt gibt es keine Kleinrammbohrung für ein Bohrprofil."]</p></div>
            }
        </figure>

        <figure class="drawing drawing-ram">
            @if (Model.RammdiagrammSvgHtml is not null)
            {
                <div class="drawing-scroll">@Html.Raw(Model.RammdiagrammSvgHtml)</div>
                <figcaption>
                    @if (Model.IstKleinrammbohrung && Model.Sonde is not null && Model.AbstandM is double d2)
                    {
                        <strong>@Model.Sonde.Bezeichnung · @DetailsModel.AbstandText(d2, Model.Loc)</strong> <span>@L["(nächstgelegene Rammsondierung)"]</span><br />
                    }
                    @L["N10 = Schläge je 10 cm Eindringung"]
                </figcaption>
            }
            else
            {
                <div class="empty-state"><p>@L["In diesem Projekt gibt es keine Rammsondierung."]</p></div>
            }
        </figure>
    </section>

    @if (Model.Bohrung is not null)
    {
        <section class="profil-section" aria-labelledby="schichten-titel">
            <h2 class="section-title" id="schichten-titel">@L["Schichtenverzeichnis"] @Model.Bohrung.Bezeichnung</h2>
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="sr-only">@L["Schichten von"] @Model.Bohrung.Bezeichnung</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="num">@L["Von–Bis [m]"]</th>
                            <th scope="col">@L["Kurzzeichen"]</th>
                            <th scope="col" class="wrap">@L["Beschreibung"]</th>
                            <th scope="col">@L["Bodengruppe"]</th>
                            <th scope="col">@L["Farbe"]</th>
                            <th scope="col">@L["Zustand"]</th>
                            <th scope="col">@L["Homogenbereich"]</th>
                            <th scope="col">@L["Frostklasse"]</th>
                            <th scope="col" class="num">kf [m/s]</th>
                            <th scope="col">@L["Versickerung"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Schichten)
                        {
                            var v = DetailsModel.Versickerung(s.KfWertMs, Model.Loc);
                            <tr>
                                <td class="num">@DetailsModel.Meter(s.VonM)–@DetailsModel.Meter(s.BisM)</td>
                                <td>@s.Kurzzeichen</td>
                                <td class="wrap">@s.Beschreibung</td>
                                <td>@(s.Bodengruppe ?? "–")</td>
                                <td>@(s.Farbe ?? "–")</td>
                                <td>@(s.Zustand ?? "–")</td>
                                <td>@(s.Homogenbereich ?? "–")</td>
                                <td class="wrap-s">@DetailsModel.FrostText(s.Frostklasse, Model.Loc)</td>
                                <td class="num">@DetailsModel.KfText(s.KfWertMs)</td>
                                <td><span class="badge @v.Css">@v.Text</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.HatKf)
            {
                <p class="note">@L["Vereinfachte Vorprüfung: Der kf-Wert ersetzt keine Bemessung nach DWA-A 138-1."]</p>
            }
        </section>

        <section class="profil-section" aria-labelledby="proben-titel">
            <h2 class="section-title" id="proben-titel">@L["Proben"]</h2>
            @if (Model.Proben.Count == 0)
            {
                <p class="muted">@L["Aus {0} wurden keine Proben entnommen.", Model.Bohrung.Bezeichnung]</p>
            }
            else
            {
                <ul class="proben-list">
                    @foreach (var p in Model.Proben)
                    {
                        <li>
                            <span class="proben-name">@p.Bezeichnung</span>
                            <span class="muted">@DetailsModel.Meter(p.VonM)–@DetailsModel.Meter(p.BisM) m</span>
                            <a href="/Projekte/@Model.Projekt.Id/Labor#probe-@p.Id">@L["Laborwerte"]</a>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
