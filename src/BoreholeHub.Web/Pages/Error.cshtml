@page "/Error"
@model BoreholeHub.Web.Pages.ErrorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["Fehler"].Value;
}

<div class="container">
    <div class="message-page">
        <p class="eyebrow">@L["Fehler"]</p>
        <h1>@L["Das hat nicht geklappt"]</h1>
        <p>@L["Beim Verarbeiten der Anfrage ist ein unerwarteter Fehler aufgetreten. Bitte versuchen Sie es noch einmal."]</p>
        <a class="btn btn-primary" href="/">@L["Zur Startseite"]</a>
    </div>
</div>
